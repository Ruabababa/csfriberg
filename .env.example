# Local HTTP server
PORT=3000
NODE_ENV=development

# Use separate random values of at least 32 bytes in production.
JWT_SECRET=
GUEST_ID_SALT=

# Local development uses SQLite. Vercel production must use pg and a pooled URL.
DB_CLIENT=sqlite
DB_URL=./data/csgofriberg.sqlite3
DB_POOL_MIN=0
DB_POOL_MAX=1
DB_ACQUIRE_TIMEOUT_MS=3000

# Use a TCP/TLS URL such as rediss://... for hosted Upstash Redis.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=csgofriberg:
REDIS_REQUIRED=false
REDIS_COMMAND_TIMEOUT_MS=1500

# Vercel adds VERCEL_URL and VERCEL_PROJECT_PRODUCTION_URL automatically.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false

# Vercel launch flags. Set both to true only on a persistent Socket.IO host.
MULTIPLAYER_ENABLED=false
VITE_MULTIPLAYER_ENABLED=false
SHOW_LEADERBOARD=true

POW_DIFFICULTY=17
POW_CHALLENGE_TTL_SECONDS=120
POW_TOKEN_TTL_SECONDS=600

UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
